/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Read QC
    //
    withName: 'NANOPLOT' {
        // Prefix the files so MultiQC can tell samples apart
        ext.args   = { "-p ${meta.id}_" }
        publishDir = [
            path: { "${params.outdir}/read_qc/nanoplot/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/read_qc/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHOPPER' {
        ext.args2  = { "--quality ${params.filter_min_quality} --minlength ${params.filter_min_length}" }
        publishDir = [
            path: { "${params.outdir}/read_qc/chopper" },
            mode: params.publish_dir_mode,
            enabled: params.save_filtered_reads,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Assembly
    //
    withName: 'NANOPLASTY_ASSEMBLE' {
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst(/^out\//, '') }
        ]
    }

    //
    // Assembly QC
    //
    withName: 'WRAP_ASSEMBLY' {
        publishDir = [ enabled: false ]
    }

    withName: 'MINIMAP2_ALIGN' {
        ext.args   = { "-x ${ [ont: 'map-ont', pacbio_hifi: 'map-hifi', pacbio_clr: 'map-pb'][meta.platform] } --secondary=no" }
        publishDir = [
            path: { "${params.outdir}/assembly_qc/alignments" },
            mode: params.publish_dir_mode,
            enabled: params.save_alignments,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_STATS|MOSDEPTH|JUNCTION_SUPPORT|QUAST' {
        publishDir = [
            path: { "${params.outdir}/assembly_qc/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Annotation
    //
    withName: 'MITOS' {
        ext.args   = { "-c ${params.mitos_code}" }
    }

    withName: 'MITOS|CHLOE' {
        publishDir = [
            path: { "${params.outdir}/annotation/${meta.id}/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BLAST_MAKEBLASTDB' {
        ext.args   = '-dbtype nucl'
        publishDir = [ enabled: false ]
    }

    withName: 'BLAST_BLASTN' {
        ext.args   = '-evalue 1e-5 -outfmt "6 qseqid sseqid pident length qstart qend sstart send evalue bitscore slen"'
    }

    withName: 'MINIPROT_ALIGN' {
        // Organellar introns are short; cap them to avoid spurious long-range models
        ext.args   = '--gff -G 20000'
    }

    withName: 'TRNASCANSE' {
        // Organellar mode: skips the eukaryotic nuclear filters
        ext.args   = '-O'
    }

    withName: 'BLAST_BLASTN|MINIPROT_ALIGN|TRNASCANSE' {
        publishDir = [
            path: { "${params.outdir}/annotation/${meta.id}/homology" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ORGANELLE_GFF' {
        publishDir = [
            path: { "${params.outdir}/annotation/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Plots and report
    //
    withName: 'CIRCOS_PLOT' {
        publishDir = [
            path: { "${params.outdir}/plots" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.summary.tsv') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
