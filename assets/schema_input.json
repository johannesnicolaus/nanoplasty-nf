{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/johannesnicolaus/nanoplasty-nf/master/assets/schema_input.json",
    "title": "johannesnicolaus/nanoplasty-nf pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$",
                "errorMessage": "Sample name must be provided and may only contain letters, digits, '_', '.' and '-'",
                "meta": [
                    "id"
                ]
            },
            "reads": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "Long-read file must be provided, cannot contain spaces and must be gzipped FASTQ (.fastq.gz or .fq.gz)"
            },
            "platform": {
                "type": "string",
                "enum": [
                    "ont",
                    "pacbio_hifi",
                    "pacbio_clr"
                ],
                "errorMessage": "Platform must be one of: ont, pacbio_hifi, pacbio_clr",
                "meta": [
                    "platform"
                ]
            },
            "type": {
                "type": "string",
                "enum": [
                    "mito",
                    "chloro",
                    "plant_mito"
                ],
                "errorMessage": "Type must be one of: mito, chloro, plant_mito",
                "meta": [
                    "type"
                ]
            },
            "genome_range": {
                "type": "string",
                "pattern": "^\\d+-\\d+$",
                "errorMessage": "Genome range must look like 12000-20000",
                "meta": [
                    "genome_range"
                ]
            },
            "seed": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "errorMessage": "Seed file must exist"
            },
            "r10": {
                "type": "boolean",
                "meta": [
                    "r10"
                ]
            },
            "min_read_length": {
                "type": "integer",
                "minimum": 0,
                "meta": [
                    "min_read_length"
                ]
            },
            "chloro_reference": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "errorMessage": "Chloroplast reference must exist"
            },
            "assembly": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?a$",
                "errorMessage": "Assembly must be an uncompressed FASTA file (.fa/.fasta); when given, NANOPlasty is skipped for this sample"
            }
        },
        "required": [
            "sample",
            "reads",
            "platform",
            "type"
        ],
        "if": {
            "properties": {
                "type": {
                    "const": "plant_mito"
                }
            },
            "required": [
                "type"
            ]
        },
        "then": {
            "anyOf": [
                {
                    "required": [
                        "chloro_reference"
                    ]
                },
                {
                    "required": [
                        "assembly"
                    ]
                }
            ],
            "errorMessage": "plant_mito samples need a chloro_reference (NANOPlasty uses it to filter plastid reads), unless an assembly is given"
        }
    }
}
