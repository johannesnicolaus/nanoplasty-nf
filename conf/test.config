/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Simulated ONT reads from the Drosophila melanogaster mitogenome (NC_024511.2).
    The samplesheet gives the reference as the assembly, so NANOPlasty is skipped
    and everything downstream (QC, MITOS2, plot, MultiQC) is exercised. Use
    --input tests/data/samplesheet_test_assemble.csv to run NANOPlasty too.

    Use as follows:
        nextflow run johannesnicolaus/nanoplasty-nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input      = "${projectDir}/tests/data/samplesheet_test.csv"
    mitos_code = 5
}
